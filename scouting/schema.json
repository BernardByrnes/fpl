{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "players"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string"},
    "agent": {"type": "string"},
    "gameweek": {"type": "integer", "minimum": 1},
    "default_expires_at": {"type": ["string", "null"]},
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["player_name"],
        "properties": {
          "player_name": {"type": "string", "minLength": 1},
          "player_id": {"type": ["integer", "null"]},
          "team_hint": {"type": "string"},
          "position_hint": {"type": "string"},
          "confidence": {"enum": ["low", "medium", "high"]},
          "observations": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string"},
                {"type": "object", "required": ["key", "value"]}
              ]
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
